# 1. 베이스 이미지
FROM node:20-alpine

# 2. 작업 디렉토리 설정
WORKDIR /app

# 3. 필요한 패키지 설치
RUN apk add --no-cache \
  python3 \
  python3-dev \
  py3-pip \
  py3-wheel \
  gcc \
  g++ \
  make \
  openjdk11 \
  musl-dev \
  linux-headers \
  libffi-dev \
  bash

# 4. Java 환경 변수 설정
ENV JAVA_HOME="/usr/lib/jvm/java-11-openjdk"
ENV PATH="$JAVA_HOME/bin:$PATH"
ENV LD_LIBRARY_PATH="$JAVA_HOME/lib/server:$LD_LIBRARY_PATH"

# 4. Python 가상 환경 생성 및 konlpy 설치
RUN python3 -m venv /app/venv \
  && . /app/venv/bin/activate \
  && pip install --upgrade pip \
  && pip install konlpy \
  && deactivate

# Python 가상환경 PATH 설정
ENV PATH="/app/venv/bin:$PATH"

# 5. Playwright 브라우저 및 기타 설치
RUN apk add --no-cache \
  chromium \
  nss \
  freetype \
  harfbuzz \
  ca-certificates \
  ttf-freefont \
  libxcomposite \
  libxrandr \
  libxi \
  libxcursor \
  libxdamage \
  libxrender \
  libxkbcommon \
  alsa-lib \
  fontconfig \
  dbus \
  dumb-init

RUN npm install playwright && npx playwright install chromium

# 6. 프로젝트 파일 복사 및 빌드
COPY package.json yarn.lock ./
RUN yarn install
COPY . .
RUN yarn build

# Python 스크립트 복사
RUN mkdir -p dist/services
COPY ./src/services/keyword_extractor.py ./dist/services/keyword_extractor.py

# 7. 포트 노출
EXPOSE 4000

# 8. 애플리케이션 실행
CMD ["node", "dist/server.js"]
